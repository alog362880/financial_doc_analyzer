# --- Application -----------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# --- Database --------------------------------------------------------------
# Local testing: SQLite (async). Production: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Ingestion -------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
MAX_DOCUMENT_CHARS=120000

# --- LLM orchestration -----------------------------------------------------
# Primary provider: "anthropic" or "gemini"
LLM_PROVIDER=gemini
# Optional fallback used only if the primary fails after retries. Leave commented out to disable.
# LLM_FALLBACK_PROVIDER=gemini
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_RETRIES=6
LLM_TIMEOUT_SECONDS=120

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY= AQ.Ab8RN6JFMEKIFo_DezHbwTctxpoVv2dD6Cvo2VQkG_3ItNNAWQ
GEMINI_MODEL=gemini-3.5-flash
